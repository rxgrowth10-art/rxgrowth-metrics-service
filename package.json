{
  "name": "rxgrowth-metrics-service",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant GoHighLevel customer metrics for restaurant locations.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:fields": "node scripts/generate-fields.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:upsert-tenant": "node scripts/upsert-tenant.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@upstash/redis": "^1.35.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  }
}
