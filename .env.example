# Tenant backend. "neon" (default) reads many tenants from Postgres.
# "env" loads one tenant from TENANT_CONFIG or the discrete TENANT_* variables.
TENANT_STORE=neon

# Neon Postgres. Required when TENANT_STORE=neon.
# Provision through the Vercel Marketplace; do not commit a real URL.
DATABASE_URL=

# Single-tenant test phase (TENANT_STORE=env). Use TENANT_CONFIG or the discrete
# variables, not both. Exactly one of apiKey / TENANT_API_KEY or
# apiKeyEncrypted / TENANT_API_KEY_ENCRYPTED. Do not commit a real token.
# TENANT_CONFIG={"locationId":"LOCATION_ID","name":"Restaurant name","apiKey":"","timezone":"Africa/Cairo","currency":"EGP","m10WorkflowId":null,"active":true}
TENANT_CONFIG=
TENANT_LOCATION_ID=
TENANT_NAME=
TENANT_API_KEY=
TENANT_API_KEY_ENCRYPTED=
TENANT_TIMEZONE=UTC
TENANT_CURRENCY=USD
TENANT_M10_WORKFLOW_ID=
TENANT_ACTIVE=true

# 32-byte AES-256-GCM key, as base64 or 64-character hex.
# Encrypts tenant GoHighLevel API keys at rest. Never commit a real key.
TENANT_ENCRYPTION_KEY=

# Upstash Redis REST. Provision through the Vercel Marketplace.
# When both are unset, idempotency falls back to process memory (tests and local only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Optional shared secret for POST /api/webhooks/ghl.
# Checked against the `x-webhook-secret` header only when this value is non-empty.
# A standard GoHighLevel Webhook action cannot sign requests, so leave it unset
# until something in front of the function can add the header.
WEBHOOK_SHARED_SECRET=

# Optional. Defaults to https://services.leadconnectorhq.com
GHL_API_BASE_URL=

# "true" lets the daily M10 cron enroll newly eligible contacts into the
# tenant's m10_workflow_id. Anything else, including unset, leaves enrollment off.
M10_ENROLL_ENABLED=false
