# Tenant backend. "neon" (default) reads many tenants from Postgres.
# "env" loads one tenant from TENANT_CONFIG or the discrete TENANT_* variables.
TENANT_STORE=neon

# Neon Postgres. Required when TENANT_STORE=neon.
# DATABASE_URL is the pooled runtime URL. Migrations use DATABASE_URL_UNPOOLED.
# The Vercel Marketplace injects both. Do not commit a real URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Single-tenant test phase (TENANT_STORE=env). Use TENANT_CONFIG or the discrete
# variables, not both. Exactly one of apiKey / TENANT_API_KEY or
# apiKeyEncrypted / TENANT_API_KEY_ENCRYPTED. Do not commit a real token.
# TENANT_CONFIG={"locationId":"LOCATION_ID","name":"Restaurant name","apiKey":"","timezone":"Africa/Cairo","currency":"EGP","m10WorkflowId":null,"active":true}
TENANT_CONFIG=
TENANT_LOCATION_ID=
TENANT_NAME=
TENANT_API_KEY=
TENANT_API_KEY_ENCRYPTED=
TENANT_TIMEZONE=UTC
TENANT_CURRENCY=USD
TENANT_M10_WORKFLOW_ID=
TENANT_ACTIVE=true
# SHA-256 hex of this tenant's webhook query token. Required in production.
# Generate with: node scripts/webhook-token.mjs
TENANT_WEBHOOK_TOKEN_HASH=

# 32-byte AES-256-GCM key, as base64 or 64-character hex.
# Encrypts tenant GoHighLevel API keys at rest. Never commit a real key.
TENANT_KEY_ENCRYPTION_KEY=

# Upstash Redis REST, Vercel KV names. Required when VERCEL_ENV=production.
# Unset outside production uses process memory.
# UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN are a fallback pair
# used only when both KV_REST_API_URL and KV_REST_API_TOKEN are unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bearer secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Optional. Defaults to https://services.leadconnectorhq.com
GHL_API_BASE_URL=

# "true" lets the daily M10 cron enroll newly eligible contacts into the
# tenant's m10_workflow_id. Anything else, including unset, leaves enrollment off.
M10_ENROLL_ENABLED=false

# Hours of order updates the daily cron recomputes before win-back eligibility.
# The test lab only fires Order Submitted, so a cancel, refund, or payment
# change on an existing order is picked up here. Invalid or unset uses 48.
M06_RECONCILE_HOURS=48

# Newest-first pages of GET /payments/orders (limit 100) scanned before eligibility.
# Default 30 covers about 3000 most recently created orders. An update to an
# older order is caught on that contact's next nudge. Invalid or unset uses 30.
M06_RECONCILE_MAX_PAGES=30
